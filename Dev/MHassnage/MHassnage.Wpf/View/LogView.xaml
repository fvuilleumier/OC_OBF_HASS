<UserControl x:Class="MHassnage.Wpf.View.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext : LogViewController. Texte sélectionnable (Ctrl+C), couleurs identiques à la console. -->
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="LinkButton">
            <Setter Property="Foreground" Value="#3DD68C" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="C" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#7CF0B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#151920" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="3">
        <DockPanel>
            <!-- Bandeau : CONSOLE … Copier tout · Effacer · ouvrir en grand -->
            <Border DockPanel.Dock="Top" Background="#1C2128" BorderBrush="#2A3038" BorderThickness="0,0,0,1" Padding="8,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copier tout" Click="OnCopyAll" Style="{StaticResource LinkButton}" />
                        <Button Content="Effacer" Click="OnClear" Style="{StaticResource LinkButton}" />
                        <Button x:Name="PopOutButton" Click="OnPopOut" ToolTip="Ouvrir la console en grand" Style="{StaticResource LinkButton}">
                            <Path Data="M 1,4 L 1,12 L 9,12 L 9,8 M 6,1 L 12,1 L 12,7 M 12,1 L 6,7"
                                  Stroke="#9AA3AF" StrokeThickness="1.3" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="CONSOLE" Foreground="#9AA3AF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <RichTextBox x:Name="Text" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource TextBrush}" CaretBrush="Transparent"
                         FontFamily="Consolas" FontSize="12" Padding="6,4"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         SelectionBrush="#41BDF5">
                <FlowDocument PageWidth="5000" PagePadding="0" />
            </RichTextBox>
        </DockPanel>
    </Border>
</UserControl>
