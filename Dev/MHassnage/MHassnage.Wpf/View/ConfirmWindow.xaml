<Window x:Class="MHassnage.Wpf.View.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MainWindowStyle}" Icon="/Resources/mhassnage.ico"
        Width="560" SizeToContent="Height" MaxHeight="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Click="OnCancel" IsCancel="True" Style="{StaticResource ActionButton}" />
            <Button x:Name="OkButton" Click="OnOk" IsDefault="True" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
    </DockPanel>
</Window>
