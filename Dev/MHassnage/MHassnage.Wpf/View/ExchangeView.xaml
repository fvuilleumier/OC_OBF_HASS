<UserControl x:Class="MHassnage.Wpf.View.ExchangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MHassnage.Wpf.View">
    <!-- DataContext : ExchangeViewController (Préparer pour l'IA / Récupérer le travail de l'IA) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, option, lancement -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{Binding PreStepLabel}" IsChecked="{Binding RunPreStep}" Margin="0,0,10,0" />
                <Button Content="{Binding RunLabel}" Command="{Binding RunCommand}" Style="{StaticResource AccentButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Résultat de l'Obfuscator : état, points à trancher, renvoi vers la WPF -->
        <Border Grid.Row="1" Padding="10" Margin="0,0,0,8" CornerRadius="4" BorderThickness="1"
                Background="{StaticResource BackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NeedsObfuscator}" Value="True">
                            <Setter Property="BorderBrush" Value="#F5A623" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsObfuscator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Ouvrir dans l'Obfuscator" Command="{Binding OpenObfuscatorCommand}" Style="{StaticResource AccentButton}" />
                    <Button Content="⟳ Revérifier" Command="{Binding RecheckCommand}" Style="{StaticResource ActionButton}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,6,0,0" MaxHeight="140">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Kind}" Width="150" Foreground="#F5A623" />
                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Un onglet de diff par dépôt (en-têtes masqués s'il n'y en a qu'un) -->
            <TabControl ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}"
                        Style="{StaticResource DarkTabs}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ShortName}" ToolTip="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <v:RepositoryView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Barre de commit commune (dépôts cochés) -->
            <v:CommitBar Grid.Row="1" DataContext="{Binding Repository.CommitBar}" Margin="0,10,0,0" />
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" />
        <v:LogPanel Grid.Row="4" DataContext="{Binding Log}" />

        <v:BusyOverlay Grid.Row="0" Grid.RowSpan="3" DataContext="{Binding Repository}" />
    </Grid>
</UserControl>
