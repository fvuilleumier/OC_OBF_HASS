<Project Sdk="Microsoft.NET.Sdk">

  <!--
    View console : point d'entrée utilisateur. Ne contient aucune règle de
    détection — elle affiche ce que les Presenters retournent et leur transmet
    les décisions saisies.

    La cible est explicitement Windows : le chiffrement élevé du coffre repose
    sur DPAPI, et déclarer la plateforme évite d'avoir à museler les
    avertissements d'analyse sur chaque appel.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Obfuscator.Cli</RootNamespace>
    <AssemblyName>obfcli</AssemblyName>

    <!-- CA1812 : les classes de commande sont instanciées par réflexion par
         Spectre.Console.Cli ; l'analyseur ne peut pas le voir. Elles restent
         internes, ce qui est le bon niveau de visibilité pour une application. -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Obfuscator.Core\Obfuscator.Core.csproj" />
  </ItemGroup>

  <!-- Le numéro de version est celui du cœur, tenu dans Obfuscator.Core.csproj. -->
  <Import Project="..\ProductVersion.targets" />

</Project>
