<Window x:Class="TebiObfuscator.Wpf.View.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TebiObfuscator.Wpf.View"
        Title="TebiObfuscator" Width="1120" Height="760" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Surface}" Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Résolution des conflits d'un fichier, passage par passage : la version
         en clair à gauche, celle de l'IA à droite. Un clic sur un côté le
         garde ; les boutons gardent l'un, l'autre, les deux, ou laissent le
         passage entre marqueurs. Rien n'est écrit ici : les choix rejoignent
         le rapatriement, écrit à la confirmation de sa liste. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="Side" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{StaticResource Background}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Code" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="ConflictTemplate" DataType="{x:Type local:ConflictRowModel}">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Border x:Name="ChoicePill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource WarningDim}">
                            <TextBlock x:Name="ChoiceText" Text="{Binding ChoiceLabel}" FontSize="11" Foreground="{StaticResource SuspectForeground}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding BeforeText}" Style="{StaticResource Code}" Foreground="{StaticResource TextMuted}"
                               Margin="2,8,0,4" Visibility="{Binding HasBefore, Converter={StaticResource Visible}}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ClearSide" Grid.Column="0" Style="{StaticResource Side}" Tag="Clear"
                                MouseLeftButtonUp="OnPickSide" ToolTip="Cliquer pour garder la version en clair">
                            <StackPanel>
                                <TextBlock Text="EN CLAIR · fichier actuel" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding ClearText}" Style="{StaticResource Code}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AiSide" Grid.Column="2" Style="{StaticResource Side}" Tag="Ai"
                                MouseLeftButtonUp="OnPickSide" ToolTip="Cliquer pour garder la version de l'IA">
                            <StackPanel>
                                <TextBlock Text="IA · version restaurée" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding AiText}" Style="{StaticResource Code}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding AfterText}" Style="{StaticResource Code}" Foreground="{StaticResource TextMuted}"
                               Margin="2,4,0,0" Visibility="{Binding HasAfter, Converter={StaticResource Visible}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Garder le clair" Tag="Clear" Click="OnChoose" Style="{StaticResource MiniButton}" Margin="0,0,6,0" />
                        <Button Content="Garder l'IA" Tag="Ai" Click="OnChoose" Style="{StaticResource MiniButton}" Margin="0,0,6,0" />
                        <Button Content="Les deux" Tag="Both" Click="OnChoose" Style="{StaticResource MiniButton}" Margin="0,0,6,0"
                                ToolTip="La version en clair, puis celle de l'IA, l'une sous l'autre." />
                        <Button Content="Non tranché" Tag="Unresolved" Click="OnChoose" Style="{StaticResource MiniButton}"
                                ToolTip="Les deux versions sont écrites entre marqueurs &lt;&lt;&lt;&lt;&lt;&lt;&lt; et &gt;&gt;&gt;&gt;&gt;&gt;&gt;, à résoudre dans votre outil git." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding KeepsClear}" Value="True">
                    <Setter TargetName="ClearSide" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="ClearSide" Property="Background" Value="{StaticResource SuccessDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KeepsAi}" Value="True">
                    <Setter TargetName="AiSide" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="AiSide" Property="Background" Value="{StaticResource SuccessDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnresolved}" Value="False">
                    <Setter TargetName="ChoicePill" Property="Background" Value="{StaticResource SuccessDim}" />
                    <Setter TargetName="ChoiceText" Property="Foreground" Value="{StaticResource Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="22,18,22,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                       Text="Chaque passage a changé des deux côtés depuis le dernier échange. À gauche, le fichier en clair tel qu'il est ; à droite, la version de l'IA, restaurée. Cliquez sur le côté à garder, ou utilisez les boutons. Un passage non tranché est écrit entre marqueurs, à résoudre ensuite dans votre outil git." />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                <TextBlock Text="Pour tous :" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                <Button Content="le clair" Tag="Clear" Click="OnChooseAll" Style="{StaticResource MiniButton}" Margin="0,0,6,0" />
                <Button Content="l'IA" Tag="Ai" Click="OnChooseAll" Style="{StaticResource MiniButton}" Margin="0,0,6,0" />
                <Button Content="non tranché" Tag="Unresolved" Click="OnChooseAll" Style="{StaticResource MiniButton}" />
                <TextBlock Name="CountText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Annuler" IsCancel="True" Click="OnCancel" />
                <Button Content="Appliquer" IsDefault="True" Click="OnConfirm" Margin="0" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,18,0"
                       Text="Rien n'est écrit ici : vos choix rejoignent le rapatriement, écrit quand vous confirmez sa liste." />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="ConflictsList" ItemTemplate="{StaticResource ConflictTemplate}" Focusable="False" />
        </ScrollViewer>
    </DockPanel>
</Window>
