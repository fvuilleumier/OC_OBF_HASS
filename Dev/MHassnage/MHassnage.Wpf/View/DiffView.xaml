<UserControl x:Class="MHassnage.Wpf.View.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MHassnage.Wpf.View">
    <!-- DataContext : FileDiff. Diff côte à côte, ancien (HEAD) à gauche, nouveau à droite. -->
    <UserControl.Resources>
        <v:DiffKindBrushConverter x:Key="KindBrush" />
        <v:LineNumberConverter x:Key="LineNumber" />

        <Style TargetType="TextBlock" x:Key="Number">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Code">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- En-tête : chemin et compteurs -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Added, StringFormat='   +{0}'}" Foreground="#6CC17A" />
                <TextBlock Text="{Binding Removed, StringFormat='  −{0}'}" Foreground="#E06C75" />
            </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding Rows}" FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource PanelBrush}" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Ligne normale -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{Binding Old.Kind, Converter={StaticResource KindBrush}, ConverterParameter=old}" />
                        <TextBlock Grid.Column="0" Style="{StaticResource Number}" Text="{Binding Old.Number, Converter={StaticResource LineNumber}}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Code}" v:DiffText.Side="{Binding Old}" ToolTip="{Binding Old.Text}" />

                        <Border Grid.Column="2" Background="{StaticResource BorderBrush}" />

                        <Border Grid.Column="3" Grid.ColumnSpan="2" Background="{Binding New.Kind, Converter={StaticResource KindBrush}, ConverterParameter=new}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Number}" Text="{Binding New.Number, Converter={StaticResource LineNumber}}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Code}" v:DiffText.IsNew="True" v:DiffText.Side="{Binding New}" ToolTip="{Binding New.Text}" />

                        <!-- Lignes identiques repliées -->
                        <Border Grid.ColumnSpan="5" Background="#2C3E50" Padding="8,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFold}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FoldedCount, StringFormat='⋯  {0} ligne(s) identique(s)'}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
