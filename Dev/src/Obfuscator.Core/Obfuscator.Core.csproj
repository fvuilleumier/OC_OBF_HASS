<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cœur métier : couches model/ et presenter/.
    Ne cible volontairement pas net10.0-windows afin de rester testable sans
    dépendance à la plateforme ; le chiffrement du coffre passe par
    l'interface IMappingProtector, dont la seule implémentation propre à
    Windows — DPAPI, le chiffrement élevé — est isolée.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Obfuscator.Core</RootNamespace>
    <AssemblyName>Obfuscator.Core</AssemblyName>

  </PropertyGroup>

  <!--
    Version du produit : le seul endroit où elle est tenue, relevée à chaque
    livraison. 1.0 : ligne de produit · 4 : version annoncée (V4) · dernier
    chiffre : itération dans cette version. L'exécutable WPF et la ligne de
    commande la reprennent à la compilation (src/ProductVersion.targets) ; la
    fenêtre l'affiche en bas à droite.
  -->
  <PropertyGroup>
    <FileVersion>1.0.4.3</FileVersion>
    <AssemblyVersion>$(FileVersion)</AssemblyVersion>
    <InformationalVersion>$(FileVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Obfuscator.Core.Tests" />
  </ItemGroup>

</Project>
