<Window x:Class="TebiObfuscator.Wpf.View.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TebiObfuscator" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Confirmation sombre : la boîte de message du système resterait claire
         au milieu d'une application entièrement sombre. -->
    <StackPanel Margin="22,20,22,18">
        <TextBlock Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" LineHeight="18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="CancelButton" IsCancel="True" Click="OnCancel" />
            <Button Name="ConfirmButton" IsDefault="True" Click="OnConfirm" Margin="0"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
