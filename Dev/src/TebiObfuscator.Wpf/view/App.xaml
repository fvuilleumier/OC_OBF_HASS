<Application x:Class="TebiObfuscator.Wpf.View.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="/view/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Le thème est fusionné au niveau de l'application : ses styles
                 implicites s'appliquent ainsi à tous les contrôles, y compris
                 ceux que les grilles créent elles-mêmes. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="theme/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
