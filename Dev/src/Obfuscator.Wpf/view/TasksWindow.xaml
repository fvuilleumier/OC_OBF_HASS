<Window x:Class="Obfuscator.Wpf.View.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Obfuscator.Wpf.View"
        Title="Tâches d'arrière-plan" Width="720" Height="480" MinWidth="540" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Background}" Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Tâches d'arrière-plan" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12"
                       Text="Les analyses tournent en arrière-plan : vous pouvez continuer à travailler pendant ce temps. Relancer une analyse annule celle qui tourne encore, dont le résultat serait déjà dépassé. L'obfuscation, elle, ne se lance qu'à la demande et n'apparaît pas ici." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox Name="AutoAnalyseCheck" Click="OnAutoAnalyseChanged"
                      ToolTip="Coché : chaque modification — terme, catégorie, valeur, proposition masquée ou gardée, occurrence exceptée — relance l'analyse en arrière-plan, après un court délai qui regroupe les clics rapprochés. Décoché : l'aperçu signale qu'une analyse est nécessaire et attend votre clic.">
                <TextBlock TextWrapping="Wrap"
                           Text="Relancer l'analyse en arrière-plan après chaque modification (recommandé ; sinon, l'aperçu signale quand elle est nécessaire)" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Name="CancelAllButton" Content="Tout annuler" Click="OnCancelAll"
                        Style="{StaticResource SubtleButton}"
                        ToolTip="Annule l'analyse en cours et celles qui attendent leur tour." />
                <Button Content="Effacer l'historique" Click="OnClearHistory" Style="{StaticResource SubtleButton}" />
                <Button Content="Fermer" Click="OnClose" Margin="0" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource Surface}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="TaskList" Margin="8,8,8,2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:BackgroundTaskItem}">
                                <Border Margin="0,0,0,6" Padding="12,9" CornerRadius="5" Background="{StaticResource Raised}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Annuler" Click="OnCancelTask"
                                                Style="{StaticResource MiniButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" />
                                        <Border x:Name="StatePill" DockPanel.Dock="Left" Style="{StaticResource Pill}"
                                                MinWidth="76" Margin="0,1,12,0" VerticalAlignment="Top"
                                                Background="{StaticResource Hover}">
                                            <TextBlock x:Name="StateText" Text="{Binding StateLabel}" FontSize="10.5"
                                                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Timing}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondary}" />
                                            <DockPanel Margin="0,7,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter TargetName="StatePill" Property="Background" Value="{StaticResource AccentDim}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                        <Setter TargetName="StatePill" Property="Background" Value="{StaticResource SuccessDim}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                        <Setter TargetName="StatePill" Property="Background" Value="{StaticResource Surface}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource TextMuted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter TargetName="StatePill" Property="Background" Value="{StaticResource DangerDim}" />
                                        <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Name="EmptyText" Text="Aucune tâche pour le moment." HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
