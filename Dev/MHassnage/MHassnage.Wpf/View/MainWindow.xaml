<Window x:Class="MHassnage.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MHassnage" Height="720" Width="1180"
        Icon="/Resources/mhassnage.ico"
        Style="{StaticResource MainWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sélecteur d'opération -->
        <DockPanel Grid.Column="0" Margin="14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                <Image Source="/Resources/mhassnage.png" Width="40" Height="40" />
                <TextBlock Text="MHassnage" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource OperationTile}" GroupName="Operations"
                                     Checked="OnOperationChecked" Tag="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Panel de l'opération (branché aux étapes suivantes) -->
        <Border Grid.Column="1" Margin="0,14,14,14" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="18">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Selected.Description}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,18" />

                <TextBlock Text="Réglages à compléter" FontWeight="SemiBold" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsProblems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding SettingsProblems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="#F5A623" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
