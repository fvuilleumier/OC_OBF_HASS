<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette sombre, accent bleu Home Assistant -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E2228" />
    <SolidColorBrush x:Key="PanelBrush" Color="#272C34" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A404A" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E9EE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3AF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#41BDF5" />
    <SolidColorBrush x:Key="AddedBrush" Color="#2E4A33" />
    <SolidColorBrush x:Key="RemovedBrush" Color="#4E2A2E" />

    <Style TargetType="Window" x:Key="MainWindowStyle">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Tuile du sélecteur d'opération -->
    <Style TargetType="RadioButton" x:Key="OperationTile">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource PanelBrush}" CornerRadius="6"
                            BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="12,10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#313742" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="#313742" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
