<Window x:Class="Obfuscator.Wpf.View.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console" Width="820" Height="500" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Background}" Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Console" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12"
                       Text="Les messages du bandeau d'état, en entier et du plus ancien au plus récent. Ils restent en mémoire le temps de la séance et ne sont jamais écrits sur disque : ils peuvent citer des valeurs réelles, prenez garde à ce que vous copiez." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copier tout" Click="OnCopyAll" Style="{StaticResource SubtleButton}"
                    ToolTip="Copie tout le contenu de la console dans le presse-papiers." />
            <Button Content="Effacer" Click="OnClear" Style="{StaticResource SubtleButton}" />
            <Button Content="Fermer" Click="OnClose" Margin="0" IsCancel="True" />
        </StackPanel>

        <!-- Une zone de texte en lecture seule : on y sélectionne et copie
             librement, ce qu'un simple bloc de texte ne permet pas. -->
        <TextBox Name="ConsoleText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas" FontSize="12" Background="{StaticResource Surface}"
                 AutomationProperties.Name="Contenu de la console" />
    </DockPanel>
</Window>
