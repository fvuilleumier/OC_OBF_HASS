<UserControl x:Class="MHassnage.Wpf.View.CommitBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext : CommitBarViewController -->
    <DockPanel>
        <!-- Dépôts concernés (affiché seulement s'il y en a plusieurs) -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Targets}" Margin="0,0,0,6">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTargets}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsAvailable}"
                              ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,16,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button Content="⬇ Pull" Command="{Binding PullCommand}" Style="{StaticResource ActionButton}"
                    ToolTip="git pull --ff-only (avance rapide uniquement)" Margin="0,0,12,0" />
            <Button Content="Commit" Command="{Binding CommitCommand}" Style="{StaticResource ActionButton}" />
            <Button Content="Push" Command="{Binding PushCommand}" Style="{StaticResource ActionButton}" />
            <Button Content="Commit &amp; Push" Command="{Binding CommitAndPushCommand}" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                 MinHeight="34" MaxHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource InputBox}" ToolTip="Message de commit" />
    </DockPanel>
</UserControl>
