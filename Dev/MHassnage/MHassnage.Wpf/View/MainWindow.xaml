<Window x:Class="MHassnage.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MHassnage.Wpf.View"
        xmlns:vc="clr-namespace:MHassnage.Wpf.ViewController"
        Title="MHassnage" Height="720" Width="1665"
        Icon="/Resources/mhassnage.ico"
        Style="{StaticResource MainWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sélecteur d'opération -->
        <DockPanel Grid.Column="0" Margin="14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                <Image Source="/Resources/mhassnage.png" Width="40" Height="40" />
                <TextBlock Text="MHassnage" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource OperationTile}" GroupName="Operations"
                                     Checked="OnOperationChecked" Loaded="OnTileLoaded" Tag="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Panel de l'opération : la vue est choisie selon le type de ViewController -->
        <Border Grid.Column="1" Margin="0,14,14,14" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="18">
            <ContentControl Content="{Binding CurrentPanel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vc:StatusViewController}">
                        <v:StatusView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vc:BackupViewController}">
                        <v:BackupView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vc:PrepareForAiViewController}">
                        <v:ExchangeView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vc:RetrieveAiWorkViewController}">
                        <v:ExchangeView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vc:ApplyViewController}">
                        <v:ApplyView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vc:PlaceholderViewController}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>
