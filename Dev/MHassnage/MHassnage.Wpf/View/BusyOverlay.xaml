<UserControl x:Class="MHassnage.Wpf.View.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Voile sombre + anneau qui tourne : bloque la saisie pendant un traitement.
         Visible quand IsBusy (propriété du DataContext) est vrai. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Background="#B31E2228" Cursor="Wait">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                <Ellipse Stroke="#3A404A" StrokeThickness="5" />
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 28,2.5 A 25.5,25.5 0 0 1 53.5,28" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="Spin" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <TextBlock Text="Traitement en cours…" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Le détail défile dans la console." HorizontalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
