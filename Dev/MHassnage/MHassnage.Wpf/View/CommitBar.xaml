<UserControl x:Class="MHassnage.Wpf.View.CommitBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext : CommitBarViewController -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
            <Button Content="Commit" Command="{Binding CommitCommand}" Style="{StaticResource ActionButton}" />
            <Button Content="Push" Command="{Binding PushCommand}" Style="{StaticResource ActionButton}" />
            <Button Content="Commit &amp; Push" Command="{Binding CommitAndPushCommand}" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                 MinHeight="34" MaxHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource InputBox}" ToolTip="Message de commit" />
    </DockPanel>
</UserControl>
